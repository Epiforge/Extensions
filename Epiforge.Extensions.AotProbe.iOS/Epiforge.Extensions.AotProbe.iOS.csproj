<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationId>com.epiforge.extensions.aotprobe</ApplicationId>
        <ApplicationTitle>AotProbe</ApplicationTitle>
        <ApplicationVersion>1</ApplicationVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
        <NoWarn>CA2252;IDE0032;IDE0079</NoWarn>
        <Nullable>enable</Nullable>
        <OutputType>Exe</OutputType>
        <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>
        <TargetFramework>net10.0-ios</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\Epiforge.Extensions.AotProbe\Probe.cs" Link="Probe.cs" />
        <Compile Include="..\Epiforge.Extensions.AotProbe\ProbePerson.cs" Link="ProbePerson.cs" />
        <Compile Include="..\Epiforge.Extensions.AotProbe\Usings.cs" Link="Usings.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Epiforge.Extensions.Expressions\Epiforge.Extensions.Expressions.csproj" />
    </ItemGroup>

</Project>
